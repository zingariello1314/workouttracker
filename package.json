{
  "name": "workout-tracker",
  "version": "1.0.0",
  "type": "module",
  "description": "Application de suivi d'entraînement Cycle 3+1",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently -n vite,api -c blue,green \"vite --port 3001\" \"node scripts/start-backend.js\"",
    "dev:frontend": "vite --port 3001",
    "dev:backend": "node scripts/start-backend.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "vite",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:perf": "playwright test --config=playwright.perf.config.js",
    "perf:baseline": "node scripts/perf/create-baseline.js",
    "bench:save": "node scripts/bench/saveActivities.js",
    "bench:load": "node scripts/bench/loadData.js",
    "bench:network": "node scripts/bench/networkResilience.js",
    "bench:metrics": "node scripts/bench/exportServerMetrics.js",
    "bench:metrics:diff": "node scripts/bench/compareMetrics.js",
    "i18n:extract": "node scripts/extract-translations.js",
    "fix:three": "node scripts/fix-three-warnings.js"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@mediapipe/pose": "^0.5.1635988167",
    "@react-three/fiber": "^8.18.0",
    "@splinetool/react-spline": "^4.1.0",
    "@splinetool/runtime": "^1.12.29",
    "@tensorflow-models/body-pix": "^2.2.1",
    "@tensorflow/tfjs": "^4.11.0",
    "adhan": "^4.4.3",
    "date-fns": "^4.1.0",
    "dompurify": "^3.3.0",
    "framer-motion": "^12.23.25",
    "idb": "^8.0.3",
    "jspdf": "^3.0.3",
    "lucide-react": "^0.263.1",
    "moment": "^2.30.1",
    "pako": "^2.1.0",
    "postprocessing": "^6.38.0",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-big-calendar": "^1.19.4",
    "react-dom": "^18.2.0",
    "react-dropzone": "^14.2.3",
    "react-webcam": "^7.1.1",
    "react-window": "^1.8.11",
    "recharts": "^3.5.1",
    "three": "^0.181.2",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@testing-library/jest-dom": "^6.3.0",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^4.0.3",
    "autoprefixer": "^10.4.14",
    "concurrently": "^9.2.1",
    "fake-indexeddb": "^5.0.1",
    "fast-check": "^4.4.0",
    "postcss": "^8.4.27",
    "tailwindcss": "^3.3.3",
    "vite": "^4.4.5",
    "vitest": "^4.0.15"
  },
  "keywords": [
    "workout",
    "fitness",
    "tracker",
    "react",
    "street-workout"
  ],
  "author": "Zinga",
  "license": "MIT",
  "overrides": {
    "three": "^0.181.2"
  },
  "resolutions": {
    "three": "^0.181.2",
    "@splinetool/react-spline/three": "^0.181.2",
    "@splinetool/runtime/three": "^0.181.2"
  }
}
