{
  "name": "workout-tracker",
  "version": "1.0.0",
  "type": "module",
  "description": "Application de suivi d'entraînement Cycle 3+1",
  "main": "index.js",
  "scripts": {
    "dev": "vite --port 3001",
    "build": "vite build",
    "preview": "vite preview",
    "start": "vite",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:perf": "playwright test --config=playwright.perf.config.js",
    "perf:baseline": "node scripts/perf/create-baseline.js",
    "bench:save": "node scripts/bench/saveActivities.js",
    "bench:load": "node scripts/bench/loadData.js",
    "bench:network": "node scripts/bench/networkResilience.js",
    "bench:metrics": "node scripts/bench/exportServerMetrics.js",
    "bench:metrics:diff": "node scripts/bench/compareMetrics.js",
    "i18n:extract": "node scripts/extract-translations.js"
  },
  "dependencies": {
    "@mediapipe/pose": "^0.5.1635988167",
    "@tensorflow-models/body-pix": "^2.2.1",
    "@tensorflow/tfjs": "^4.11.0",
    "jspdf": "^3.0.3",
    "lucide-react": "^0.263.1",
    "pako": "^2.1.0",
    "postprocessing": "^6.38.0",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^14.2.3",
    "react-webcam": "^7.1.1",
    "react-window": "^1.8.10",
    "recharts": "^3.3.0",
    "three": "^0.181.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@testing-library/jest-dom": "^6.3.0",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^4.0.3",
    "autoprefixer": "^10.4.14",
    "fake-indexeddb": "^5.0.1",
    "postcss": "^8.4.27",
    "tailwindcss": "^3.3.3",
    "vite": "^4.4.5"
  },
  "keywords": [
    "workout",
    "fitness",
    "tracker",
    "react",
    "street-workout"
  ],
  "author": "Zinga",
  "license": "MIT"
}
