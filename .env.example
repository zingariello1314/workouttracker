# Copier vers .env.local et adapter (non versionné)

# --- GitHub (module « Code » du dashboard) ---
# Crée une OAuth App GitHub : https://github.com/settings/developers
# Callback URL exacte : http://localhost:3001/?oauth=github  (adapter le domaine en prod)
# VITE_GITHUB_CLIENT_ID=Iv1.xxxxxxxxxxxxxxxx
#
# Échange du code OAuth : le backend (port 8000) doit avoir le secret GitHub dans .env racine OU backend/.env :
# GITHUB_CLIENT_SECRET=ghp_... ou le secret « OAuth » généré sur la page de l’app GitHub
# (le Client ID peut être envoyé par le navigateur ; seul le secret reste côté serveur.)

# Niveau des logs applicatifs (src/utils/logger.js)
# silent | error | warn | info | debug
# Par défaut (sans variable) : warn → console calme (WARN + ERROR seulement)
# Pour tout réactiver comme avant : debug
# VITE_LOG_LEVEL=debug

# --- EmailJS (vérification d’email dans l’app, gratuit ~200 envois/mois) ---
# Compte : https://www.emailjs.com/ — créer un service email + un template avec les variables :
#   {{to_email}} ou destinataire selon ton template, {{verification_code}}, {{display_name}}
# VITE_EMAILJS_SERVICE_ID=service_xxxx
# VITE_EMAILJS_TEMPLATE_ID=template_xxxx
# VITE_EMAILJS_PUBLIC_KEY=xxxxxxxx

# --- Sync / API Momentum v1 + Supabase (optionnel) ---
# Base du FastAPI si différente de VITE_AUTH_SERVER_BASE (défaut http://127.0.0.1:8000)
# VITE_MOMENTUM_API_V1_BASE=http://127.0.0.1:8000
#
# Backend (même fichier .env à la racine que charge `zlib_server`) : si erreur DNS vers z-library.sk
# et que tu n’utilises pas BookFinder, mets ZLIB_DISABLE_STARTUP=1 pour démarrer sans tenter Z-Library.
# ZLIB_DISABLE_STARTUP=1
#
# Projet Supabase (free tier) — laisser vide tant que non utilisé ; le bundle n’initialise pas le client sans ces deux clés.
# VITE_SUPABASE_URL=https://xxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
#
# Phase 3 (dual-write intentions — jalon, désactivé par défaut) :
# VITE_PHASE3_DUAL_WRITE=1
# VITE_PHASE3_MIGRATION_ON_FOCUS=1
#
# Miroir intentions Phase 2 (FastAPI uniquement, secret — pas de préfixe VITE_) :
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
