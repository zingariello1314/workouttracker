# Z-Library - Ne jamais commiter le fichier .env avec de vrais identifiants
ZLIB_EMAIL=ton_email@example.com
ZLIB_PASSWORD=ton_mot_de_passe
# Si 1 : ne tente pas la connexion Z-Library au démarrage (auth + /api/v1 OK ; BookFinder désactivé).
# Utile si DNS/réseau bloquent z-library.sk ou si tu n’utilises pas BookFinder.
# ZLIB_DISABLE_STARTUP=1

# GitHub OAuth (échange code → token + proxy GraphQL pour le module Code)
# Obligatoire : le secret ne doit JAMAIS être dans le frontend.
GITHUB_CLIENT_SECRET=
# Optionnel si le frontend envoie déjà client_id (VITE_GITHUB_CLIENT_ID dans .env.local) :
# GITHUB_CLIENT_ID=

# Supabase (Phase 2 — miroir intentions, backend uniquement ; jamais dans VITE_*)
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Auth serveur (P3)
# Secret HMAC pour signer les JWT d'accès. À définir avec une longue valeur aléatoire **stable**
# (même valeur à chaque démarrage) : sans cela, un secret aléatoire est régénéré à chaque lancement
# du processus et les anciens access tokens ne sont plus valides jusqu’au prochain `/auth/refresh`.
# Les refresh tokens restent dans `auth_server.db` ; le client conserve la session si le refresh
# réussit et si les jetons ne sont pas effacés sur erreur réseau (comportement corrigé côté app).
AUTH_JWT_SECRET=
# Durée du token d'accès en minutes
AUTH_ACCESS_TTL_MIN=15
# Durée du refresh token en jours
AUTH_REFRESH_TTL_DAYS=30
