import React, { memo } from 'react';

/**
 * Module d'apprentissage express (Position 21)
 * Affiche les sessions d'apprentissage récentes et la progression
 */
const ExpressLearningModule = memo(({ 
  navigation,
  data = {}
}) => {
  const subjects = data.subjects || [];
  const recentSessions = data.today?.learningSessions || [];
  const totalStudyTime = recentSessions.reduce((total, session) => total + (session.duration || 0), 0);

  const handleNavigateToSettings = () => {
    if (navigation) {
      navigation.toSettings({ section: 'learning' });
    }
  };

  const formatTime = (minutes) => {
    if (minutes < 60) return `${minutes}min`;
    const hours = Math.floor(minutes / 60);
    const mins = minutes % 60;
    return mins > 0 ? `${hours}h${mins}min` : `${hours}h`;
  };

  return (
    <section className="sidebar-section">
      <header className="sidebar-section-header">
        <h2 className="sidebar-section-title">
          <span className="sidebar-section-icon" aria-hidden="true">🧠</span>
          Apprentissage Express
        </h2>
      </header>
      
      <div className="sidebar-section-content">
        {recentSessions.length > 0 || subjects.length > 0 ? (
          <div className="learning-info">
            {totalStudyTime > 0 && (
              <div className="study-time">
                <span className="time-icon">⏱️</span>
                <span className="time-text">{formatTime(totalStudyTime)} aujourd'hui</span>
              </div>
            )}
            
            {subjects.length > 0 && (
              <div className="subjects-list">
                <span className="subject-icon">📚</span>
                <span className="subject-count">{subjects.length} matière{subjects.length > 1 ? 's' : ''} active{subjects.length > 1 ? 's' : ''}</span>
              </div>
            )}
            
            {recentSessions.length > 0 && (
              <div className="sessions-info">
                <span className="session-icon">✅</span>
                <span className="session-text">{recentSessions.length} session{recentSessions.length > 1 ? 's' : ''} récente{recentSessions.length > 1 ? 's' : ''}</span>
              </div>
            )}
          </div>
        ) : (
          <div className="empty-state">
            <span className="empty-icon">🧠</span>
            <p>Aucune session aujourd'hui</p>
          </div>
        )}
        
        <div className="navigation-section">
          <button 
            onClick={handleNavigateToSettings}
            className="nav-button"
            type="button"
          >
            <span className="nav-icon">⚙️</span>
            <span className="nav-text">Paramètres Apprentissage</span>
            <span className="nav-arrow">→</span>
          </button>
        </div>
      </div>
    </section>
  );
});

ExpressLearningModule.displayName = 'ExpressLearningModule';

export default ExpressLearningModule;